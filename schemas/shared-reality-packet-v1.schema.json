{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonreality.example/schemas/shared-reality-packet-v1.schema.json",
  "title": "Shared Reality Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "version", "question", "scope", "status", "sources", "claims", "evidence_objects", "interpretations", "value_positions", "action_options", "unknowns", "minority_reports", "transformation_contract", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"$ref": "#/$defs/nonEmptyString"},
    "version": {"type": "integer", "minimum": 1},
    "question": {"$ref": "#/$defs/nonEmptyString"},
    "scope": {"$ref": "#/$defs/scope"},
    "status": {"enum": ["draft", "source_frozen", "reviewed", "published"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence_objects": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "interpretations": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}},
    "value_positions": {"type": "array", "items": {"$ref": "#/$defs/valuePosition"}},
    "action_options": {"type": "array", "items": {"$ref": "#/$defs/actionOption"}},
    "unknowns": {"$ref": "#/$defs/stringArray"},
    "minority_reports": {"type": "array", "items": {"$ref": "#/$defs/minorityReport"}},
    "transformation_contract": {"$ref": "#/$defs/transformationContract"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "valid_at", "jurisdictions", "populations", "exclusions"],
      "properties": {
        "description": {"$ref": "#/$defs/nonEmptyString"}, "valid_at": {"type": "string", "format": "date-time"},
        "jurisdictions": {"$ref": "#/$defs/stringArray"}, "populations": {"$ref": "#/$defs/stringArray"}, "exclusions": {"$ref": "#/$defs/stringArray"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "title", "content_digest", "source_type", "retrieved_at", "issuer", "locator", "quality_notes", "limitations"],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonEmptyString"}, "title": {"$ref": "#/$defs/nonEmptyString"}, "content_digest": {"type": "string", "minLength": 8},
        "source_type": {"enum": ["primary", "official", "research", "data", "testimony", "analysis", "media", "other"]}, "retrieved_at": {"type": "string", "format": "date-time"},
        "issuer": {"type": ["string", "null"]}, "locator": {"type": ["string", "null"]}, "quality_notes": {"$ref": "#/$defs/nonEmptyString"}, "limitations": {"$ref": "#/$defs/stringArray"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "proposition", "claim_type", "status", "evidence_for", "evidence_against", "applicability", "uncertainty", "materiality"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/nonEmptyString"}, "proposition": {"$ref": "#/$defs/nonEmptyString"},
        "claim_type": {"enum": ["observation", "measurement", "event", "association", "generalization", "forecast"]},
        "status": {"enum": ["supported", "contested", "uncertain", "unsupported", "outdated", "refuted"]},
        "evidence_for": {"$ref": "#/$defs/stringArray"}, "evidence_against": {"$ref": "#/$defs/stringArray"}, "applicability": {"type": "string"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"}, "materiality": {"enum": ["low", "medium", "high", "critical"]}
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false, "required": ["level", "reasons"],
      "properties": {"level": {"enum": ["low", "moderate", "high", "unknown"]}, "reasons": {"$ref": "#/$defs/stringArray"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_refs", "summary", "direction", "limitations", "confidence"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"}, "source_refs": {"$ref": "#/$defs/stringArray"}, "summary": {"$ref": "#/$defs/nonEmptyString"},
        "direction": {"enum": ["supports", "challenges", "contextualizes", "neutral"]}, "limitations": {"$ref": "#/$defs/stringArray"}, "confidence": {"enum": ["low", "medium", "high", "not_scored"]}
      }
    },
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": ["interpretation_id", "description", "claim_refs", "assumptions", "counterarguments", "distinguishing_tests"],
      "properties": {
        "interpretation_id": {"$ref": "#/$defs/nonEmptyString"}, "description": {"$ref": "#/$defs/nonEmptyString"}, "claim_refs": {"$ref": "#/$defs/stringArray"},
        "assumptions": {"$ref": "#/$defs/stringArray"}, "counterarguments": {"$ref": "#/$defs/stringArray"}, "distinguishing_tests": {"$ref": "#/$defs/stringArray"}
      }
    },
    "valuePosition": {
      "type": "object", "additionalProperties": false, "required": ["value_id", "statement", "holder_scope", "tensions_with"],
      "properties": {"value_id": {"$ref": "#/$defs/nonEmptyString"}, "statement": {"$ref": "#/$defs/nonEmptyString"}, "holder_scope": {"$ref": "#/$defs/nonEmptyString"}, "tensions_with": {"$ref": "#/$defs/stringArray"}}
    },
    "actionOption": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "action", "assumptions", "affected_groups", "risks", "reversibility", "success_measures", "stop_conditions"],
      "properties": {
        "option_id": {"$ref": "#/$defs/nonEmptyString"}, "action": {"$ref": "#/$defs/nonEmptyString"}, "assumptions": {"$ref": "#/$defs/stringArray"},
        "affected_groups": {"$ref": "#/$defs/stringArray"}, "risks": {"$ref": "#/$defs/stringArray"}, "reversibility": {"enum": ["high", "moderate", "low", "irreversible"]},
        "success_measures": {"$ref": "#/$defs/stringArray"}, "stop_conditions": {"$ref": "#/$defs/stringArray"}
      }
    },
    "minorityReport": {
      "type": "object", "additionalProperties": false, "required": ["report_id", "position", "evidence_refs", "unresolved_risk"],
      "properties": {"report_id": {"$ref": "#/$defs/nonEmptyString"}, "position": {"$ref": "#/$defs/nonEmptyString"}, "evidence_refs": {"$ref": "#/$defs/stringArray"}, "unresolved_risk": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "transformationContract": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_profile_fields", "allowed_transformations", "forbidden_transformations", "required_materiality_levels"],
      "properties": {"allowed_profile_fields": {"$ref": "#/$defs/stringArray"}, "allowed_transformations": {"$ref": "#/$defs/stringArray"}, "forbidden_transformations": {"$ref": "#/$defs/stringArray"}, "required_materiality_levels": {"$ref": "#/$defs/stringArray"}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_digest", "object_root", "created_at", "authors", "reviewers", "signatures", "transparency_receipts", "supersedes"],
      "properties": {
        "manifest_digest": {"type": "string", "minLength": 8}, "object_root": {"type": "string", "minLength": 8}, "created_at": {"type": "string", "format": "date-time"},
        "authors": {"$ref": "#/$defs/stringArray"}, "reviewers": {"$ref": "#/$defs/stringArray"}, "signatures": {"$ref": "#/$defs/stringArray"}, "transparency_receipts": {"$ref": "#/$defs/stringArray"}, "supersedes": {"type": ["string", "null"]}
      }
    }
  }
}
